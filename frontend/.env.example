# Gezify API (no trailing slash). Must match backend CORS (e.g. appsettings Cors:AllowedOrigin).
VITE_API_URL=https://localhost:7156

# OAuth 2.0 Web client ID from Google Cloud (same as backend Google:ClientId).
VITE_GOOGLE_CLIENT_ID=

# Optional. Defaults to `${origin}/auth/callback`. Must be listed under Authorized redirect URIs in Google Cloud.
# VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
