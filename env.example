# Copy to .env and load in your shell/IDE, or set in Railway.

# Preferred on Railway (Postgres plugin injects this).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Local development (native PostgreSQL on your machine):
# 1. Ensure PostgreSQL 16 is running and create a database, e.g.:
#      psql -U postgres -c "CREATE DATABASE gezify;"
# 2. Without DATABASE_URL, the API uses ConnectionStrings:Database from
#    appsettings.Development.json (adjust user/password/host/port there if needed).
# 3. To avoid committing credentials, use user secrets instead:
#      cd backend
#      dotnet user-secrets init
#      dotnet user-secrets set ConnectionStrings:Database "Host=localhost;Port=5432;Database=gezify;Username=postgres;Password=YOUR_PASSWORD"

# Production migrations (§11.3): apply before deploying a new API release, not on container start.
#   dotnet tool restore
#   dotnet ef database update --project backend --startup-project backend
