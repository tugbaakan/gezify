{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "dotnet publish Gezify.Api.csproj -c Release -o out"
  },
  "deploy": {
    "startCommand": "dotnet out/Gezify.Api.dll",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE"
  }
}
